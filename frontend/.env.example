# Copy this file to frontend/.env. EXPO_PUBLIC values can be included in the app bundle.
# Android emulator: http://10.0.2.2:8000
# Expo Go / physical device: use this computer's LAN IP, for example http://192.168.0.10:8000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=climbing-videos
# Kakao Maps JavaScript SDK browser key. Restrict its JavaScript SDK domain in Kakao Developers.
EXPO_PUBLIC_KAKAO_JAVASCRIPT_KEY=your-kakao-javascript-key
# Never add a Kakao REST/Admin key, Supabase service-role key, DATABASE_URL, or JWT secret to frontend env files.
